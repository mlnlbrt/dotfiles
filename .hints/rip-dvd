For DVD with a movie, rip its main feature and write down stream info:
    $ DEVICE="/dev/sr0"; \
        AUD_LANGUAGE="en"; \
        SUB_LANGUAGE="pl"; \
        LSDVD_JSON=$(lsdvd -Oy $DEVICE \
            | grep -v libdvdread \
            | sed -e 's/^lsdvd = //' -e "s/'/\"/g" \
            | tr -d '\n'| sed -e 's/,\s*}/}/g' -e 's/,\s*]/]/g'); \
        LSDVD_TITLE=$(echo $LSDVD_JSON | jq -r .title); \
        LSDVD_TRACK=$(echo $LSDVD_JSON | jq -r .longest_track); \
        LSDVD_AUD_STRING=$(lsdvd -t $LSDVD_TRACK -a $DEVICE | grep "Language: $AUD_LANGUAGE" | grep -vi "comments"); \
        LSDVD_AUD_STREAM=$(echo ${LSDVD_AUD_STRING##*: }); \
        LSDVD_SUB_STRING=$(lsdvd -t $LSDVD_TRACK -s $DEVICE | grep "Language: $SUB_LANGUAGE"); \
        LSDVD_SUB_STREAM="$(echo ${LSDVD_SUB_STRING##*: })"; \
        echo "TITLE: "$LSDVD_TITLE; \
        echo "TRACK: "$LSDVD_TRACK; \
        echo "AUD: "$LSDVD_AUD_STREAM; \
        echo "SUB: "$LSDVD_SUB_STREAM; \
        mkdir -p "$LSDVD_TITLE"; \
        pushd "$LSDVD_TITLE"; \
        echo ${LSDVD_AUD_STREAM:0:4} > aud_stream; \
        echo ${LSDVD_SUB_STREAM:0:4} > sub_stream; \
        dvdbackup --input=$DEVICE -pF && rm */VIDEO_TS/*_0.VOB; \
        popd

Convert VODs to MKV:
    $ FFMPEG_PARAMS="-fflags +genpts+igndts -analyzeduration 1000M -probesize 1000M"; \
        CODEC_CFG="-c:v copy -c:a copy -c:s dvdsub"; \
        for ROOT_DIR in */; do \
            pushd $ROOT_DIR; \
                for TITLE_DIR in */; do \
                    VOB_LIST=$(ls -1 "$TITLE_DIR"VIDEO_TS/*VOB \
                        | sort | awk '{ ORS="|"; print; }' | sed 's/.$//');
                    FFMPEG_AUD=$(ffmpeg $FFMPEG_PARAMS -i concat:"$VOB_LIST" 2>&1 \
                        | grep $(cat aud_stream)); \
                    FFMPEG_AUD=${FFMPEG_AUD#*Stream #0:}; \
                    FFMPEG_AUD=${FFMPEG_AUD%[*}; \
                    FFMPEG_SUB=$(ffmpeg $FFMPEG_PARAMS -i concat:"$VOB_LIST" 2>&1 \
                        | grep $(cat sub_stream)); \
                    FFMPEG_SUB=${FFMPEG_SUB#*Stream #0:}; \
                    FFMPEG_SUB=${FFMPEG_SUB%[*}; \
                    MAP_CFG="-map 0:v -map 0:$FFMPEG_AUD -map 0:$FFMPEG_SUB"; \
                    ffmpeg $FFMPEG_PARAMS \
                        -ifo_palette "$TITLE_DIR"VIDEO_TS/*.IFO \
                        -i concat:"$VOB_LIST" \
                        $CODEC_CFG \
                        $MAP_CFG \
                        -y ../"${TITLE_DIR%?}.mkv" ;\
                done; \
            popd; \
        done
