Extract audio tracks from FLAC/CUE
    $ for i in */; do \
        pushd "$i"; \
            for i in *.cue; do shnsplit -f "$i" -o flac "$(basename "$i" .cue)".flac; done \
            && rm *-track00.flac; \
        popd; \
    done

Rename folder.jpg to cover.jpg
    $ for i in */Front.jpg; do mv "$i" "$(dirname "$i")"/cover.jpg; done
